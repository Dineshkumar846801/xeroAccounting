# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Connection string for your PostgreSQL database (must exist and be reachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xero_accounting

# -----------------------------------------------------------------------------
# Security & Token Encryption
# -----------------------------------------------------------------------------
# 64-character hexadecimal key used for AES-256-GCM encryption of stored Xero tokens
# Generate your own using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
XERO_TOKEN_ENCRYPTION_KEY=dd578fe8d2b6ec2dac8f6d41baf25c7a32ac9d14ffeffbf55bca64e1fab85af3

# -----------------------------------------------------------------------------
# Xero OAuth 2.0 Integration
# -----------------------------------------------------------------------------
# Obtain from https://developer.xero.com/ under "My Apps"
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here

# Must match exactly with the redirect URI registered in the Xero Developer Portal
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# OAuth scopes used for reading invoices, contacts, accounts, and reports
XERO_SCOPES="openid profile email offline_access accounting.invoices.read accounting.contacts.read accounting.settings.read accounting.reports.read accounting.transactions.read"
